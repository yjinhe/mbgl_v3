ARG NODE_VERSION=22-bookworm-slim
ARG NGINX_VERSION=1.28-alpine
ARG APP_VERSION=0.1.0
ARG BUILD_SHA=unknown

FROM node:${NODE_VERSION} AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

RUN corepack enable \
  && corepack prepare pnpm@10.33.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/wechat-miniprogram/package.json apps/wechat-miniprogram/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/web apps/web
COPY apps/console apps/console

RUN pnpm --filter @tangji/shared build \
  && pnpm --filter @tangji/web build \
  && pnpm --filter @tangji/console build

FROM nginx:${NGINX_VERSION}

ARG APP_VERSION
ARG BUILD_SHA

LABEL org.opencontainers.image.title="Tangji Frontends" \
  org.opencontainers.image.version="${APP_VERSION}" \
  org.opencontainers.image.revision="${BUILD_SHA}"

ENV APP_VERSION="${APP_VERSION}" \
  BUILD_SHA="${BUILD_SHA}"

COPY docker/nginx-frontends.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html/web
COPY --from=build /app/apps/console/dist /usr/share/nginx/html/console

RUN printf '{"version":"%s","buildSha":"%s"}\n' "$APP_VERSION" "$BUILD_SHA" \
  | tee /usr/share/nginx/html/web/build.json /usr/share/nginx/html/console/build.json >/dev/null

EXPOSE 80 8080
