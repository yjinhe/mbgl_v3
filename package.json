{
  "name": "tangji-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tangji/api --filter @tangji/web --filter @tangji/console dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "style:extract": "node scripts/extract-styles.mjs",
    "seed": "pnpm --filter @tangji/api seed",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:api:build": "docker compose -f docker-compose.api.yml build",
    "docker:api:up": "docker compose -f docker-compose.api.yml up -d",
    "docker:api:down": "docker compose -f docker-compose.api.yml down",
    "docker:api:logs": "docker compose -f docker-compose.api.yml logs -f tangji-api"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.1"
}
