DATABASE_URL="file:./dev.db"
# JWT_SECRET 为必填项，API 启动时缺失会直接报错；生产环境请使用 openssl rand -hex 32 生成 32 位以上密钥。
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"
# WECHAT_MOCK 默认 false，仅显式设为 true 时启用 mock 微信登录（生产环境禁止）。
WECHAT_MOCK=true
WECHAT_APPID=""
WECHAT_SECRET=""
WECHAT_WEB_APPID=""
WECHAT_WEB_SECRET=""
WECHAT_WEB_REDIRECT_URI="http://127.0.0.1:5173"
# 小程序测量提醒（一次性订阅消息，docs/WECHAT-REMINDER-SPEC.md）。模板 ID 留空则功能整体关闭。
# *_FIELDS 为模板字段 key，按消息顺序用英文逗号分隔。待确认：从公众平台「订阅消息 → 我的模板 → 详情」抄录。
WECHAT_TEMPLATE_GLUCOSE_REMINDER=""
WECHAT_TEMPLATE_GLUCOSE_FIELDS="time1,thing2,thing3"
WECHAT_TEMPLATE_BP_REMINDER=""
WECHAT_TEMPLATE_BP_FIELDS="time1,thing2"
# formal | trial | developer，体验版联调时用 trial。
WECHAT_MINIPROGRAM_STATE="formal"
TZ=Asia/Shanghai
PORT=3001
VITE_API_BASE="http://127.0.0.1:3001"
VITE_WECHAT_WEB_APPID=""
ADMIN_INIT_USERNAME="admin"
ADMIN_INIT_PASSWORD="Admin@123456"
WEB_ORIGIN="http://127.0.0.1:5173,http://127.0.0.1:5174"
APP_ORIGIN="http://127.0.0.1:5173"
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT=300
EXPORT_MAX_RECORDS=10000
LOG_LEVEL="warn"
APP_VERSION="0.1.0"
BUILD_SHA="development"
