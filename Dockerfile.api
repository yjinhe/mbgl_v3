FROM node:20-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.33.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json

RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/api apps/api
COPY docker/api-entrypoint.sh docker/api-entrypoint.sh

RUN pnpm --filter @tangji/shared build \
  && pnpm --filter @tangji/api prisma:generate \
  && chmod +x docker/api-entrypoint.sh \
  && mkdir -p /data

EXPOSE 3001

VOLUME ["/data"]

ENTRYPOINT ["/app/docker/api-entrypoint.sh"]
CMD ["pnpm", "--filter", "@tangji/api", "exec", "tsx", "src/server.ts"]
