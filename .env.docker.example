# 复制为 .env.docker 后在 VPS 上修改。
# 第一次演示初始化可设为 true；完成 seed 后建议改回 false，避免重启时重置演示数据。
SEED_ON_BOOT=true

# 小程序体验版如果暂时不接真实微信登录，可用 true；正式发布建议 false 并填写 WECHAT_APPID / WECHAT_SECRET。
WECHAT_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=

# 请换成足够长的随机字符串。
JWT_SECRET=change-me-to-a-long-random-secret

# 如果后续同时部署 H5 / 药房后台，这里填对应前端域名；当前后端 CORS 允许任意 origin，本项保留兼容配置。
WEB_ORIGIN=https://console.example.com

TZ=Asia/Shanghai
ADMIN_INIT_PASSWORD=Admin@123456
