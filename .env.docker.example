# 复制为 .env.docker 后在 VPS 上修改。
# seed 会清空现有业务数据，只允许在全新的演示环境中临时开启一次。
IMAGE_TAG=dev
TANGJI_API_IMAGE=tangji-api
TANGJI_FRONTEND_IMAGE=tangji-frontends
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=768m
API_PIDS_LIMIT=256
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_PIDS_LIMIT=128

SEED_ON_BOOT=false
ALLOW_DESTRUCTIVE_SEED=false

# 仅旧版 db push 创建的现有数据库首次切换 migration 时临时设为 true，成功后必须改回 false。
BASELINE_INITIAL_MIGRATION=false

# Docker 生产环境禁止 mock。小程序为可选渠道，启用时两项必须同时填写。
WECHAT_MOCK=false
WECHAT_APPID=
WECHAT_SECRET=

# 微信网页授权为可选登录方式，启用时 AppID/Secret 必须同时填写。
# 回调必须是 HTTPS，且与 APP_ORIGIN 同源。
# 小程序与公众号必须绑定到同一个微信开放平台账号，确保两端均返回相同 UnionID。
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
WECHAT_WEB_REDIRECT_URI=https://app.example.com

# 小程序测量提醒（一次性订阅消息，见 docs/WECHAT-REMINDER-SPEC.md）。需要 WECHAT_APPID/WECHAT_SECRET；
# 模板 ID 留空则整个提醒功能关闭，小程序会隐藏相关入口。
# *_FIELDS 是模板字段 key，按消息顺序用英文逗号分隔（血糖：测量时间,测量时段,温馨提示；血压：提醒时间,备注）。
# 待确认：从公众平台「订阅消息 → 我的模板 → 详情」抄录，填错会收到 errcode 47003。
WECHAT_TEMPLATE_GLUCOSE_REMINDER=
WECHAT_TEMPLATE_GLUCOSE_FIELDS=time1,thing2,thing3
WECHAT_TEMPLATE_BP_REMINDER=
WECHAT_TEMPLATE_BP_FIELDS=time1,thing2
# formal | trial | developer；体验版联调先用 trial，收到消息后改回 formal。
WECHAT_MINIPROGRAM_STATE=formal

# 使用 openssl rand -hex 32 生成。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 浏览器允许的来源，多个域名用英文逗号分隔；小程序请求不受浏览器 CORS 限制。
WEB_ORIGIN=https://app.example.com,https://console.example.com
APP_ORIGIN=https://app.example.com

# API 只接受一层受信任反向代理；宿主机端口不得暴露公网。
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT=300
EXPORT_MAX_RECORDS=10000
LOG_LEVEL=info

TZ=Asia/Shanghai
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
