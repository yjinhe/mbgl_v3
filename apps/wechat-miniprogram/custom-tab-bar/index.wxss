:host {
  position: relative;
  z-index: 30;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  width: auto;
  min-width: 0;
  overflow: visible;
  line-height: 1;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

.tabbar {
  --ink-3: #7A8A85;
  --card: #FFFFFF;
  --line: #E4EAE7;
  --brand: #0E7E6B;
  --brand-soft: #E2F1EC;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: auto;
  padding: 6rpx 12rpx env(safe-area-inset-bottom);
  padding-bottom: max(4rpx, calc(env(safe-area-inset-bottom) - 16rpx));
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
  background: var(--card);
  box-shadow: 0 8rpx 30rpx rgba(22, 48, 43, .10);
}

.tab {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 20rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.1;
}

.ti {
  width: 48rpx;
  height: 48rpx;
  opacity: .72;
}

.tab.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 650;
}

.tab.on .ti {
  opacity: 1;
  transform: scale(1.05);
}

.fab-slot {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 104rpx;
}

.fab {
  position: absolute;
  left: 50%;
  top: -40rpx;
  transform: translateX(-50%);
  width: 108rpx;
  height: 108rpx;
  border: 6rpx solid var(--card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  box-shadow: 0 16rpx 40rpx rgba(14, 126, 107, .42), inset 0 2rpx 0 rgba(255, 255, 255, .28);
}

.fab image {
  width: 48rpx;
  height: 48rpx;
}

.fab-label {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 650;
  white-space: nowrap;
}

.tab-pressed {
  opacity: .68;
}
