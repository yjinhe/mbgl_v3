<view class="app-stage">
  <view class="screen">
    <view class="safe-navbar" style="{{navStyle}}">
      <button class="back" bindtap="back">‹</button>
      <view class="title">回收站</view>
    </view>
    <view class="pages">
      <view class="page recycle-page">
        <block wx:if="{{!authed}}">
          <view class="empty">
            <view>登录后查看回收站</view>
            <button class="btn primary login-btn" bindtap="login">微信一键登录</button>
          </view>
        </block>

        <block wx:else>
          <view wx:if="{{!hasItems}}" class="empty">回收站为空 · 删除的记录会在这里保留 7 天</view>

          <view wx:for="{{items}}" wx:key="id" class="record card">
            <view class="bar" style="background:{{item.statusColorValue}}"></view>
            <view class="record-main">
              <view class="record-line">
                <text>{{item.metricName}} · {{item.periodText}}</text>
                <text class="pill {{item.statusClass}}">{{item.status.label}}</text>
              </view>
              <view class="record-sub">{{item.dateText}} {{item.timeText}} · 剩余 {{item.daysLeft}} 天</view>
              <view class="record-value num" style="{{item.statusStyle}}">{{item.readText}}</view>
            </view>
            <button class="restore" data-metric="{{item.metric}}" data-id="{{item.id}}" catchtap="restore">恢复</button>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
