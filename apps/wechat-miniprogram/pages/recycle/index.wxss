.recycle-page {
  padding-bottom: 48rpx;
}

.login-btn {
  margin-top: 24rpx;
}

.record {
  position: relative;
  margin-top: 18rpx;
  padding: 22rpx 22rpx 22rpx 34rpx;
  display: flex;
  gap: 16rpx;
}

.bar {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 8rpx;
  border-radius: 0 999rpx 999rpx 0;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-weight: 800;
}

.record-sub {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-value {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 850;
}

.restore {
  width: 120rpx;
  height: 64rpx;
  border-radius: 18rpx;
  align-self: center;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.record-ops {
  width: 132rpx;
  flex: 0 0 132rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.purge {
  width: 132rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 750;
}
