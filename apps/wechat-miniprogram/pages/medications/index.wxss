/* Elder-friendly sizes (docs/WECHAT-HOME-REDESIGN.md §3): text ≥ 24rpx,
   tap targets ≥ 96rpx, ≥ 16rpx between adjacent controls, state = icon + text. */
.medications-page {
  height: calc(100vh - 156rpx);
  padding-bottom: 48rpx;
}

.login-btn {
  margin-top: 24rpx;
}

.med-sec-label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.med-day {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 500;
}

.med-empty {
  text-align: center;
}

.med-empty-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.4;
}

.med-empty-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.med-empty-add {
  min-height: 108rpx;
  margin-top: 24rpx;
  font-size: 32rpx;
}

.slot-card {
  padding: 20rpx 28rpx 8rpx;
}

.slot-time {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
  color: var(--brand-deep);
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.3;
}

.slot-row {
  min-height: 112rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slot-row:last-child {
  border-bottom: 0;
}

.slot-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.take-btn {
  min-width: 220rpx;
  min-height: 96rpx;
  flex: none;
  padding: 0 24rpx;
  border: 3rpx solid var(--ok);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--card);
  color: var(--ok);
  font-size: 28rpx;
  font-weight: 700;
}

.take-btn.on {
  background: var(--ok);
  color: #fff;
}

.take-btn[disabled] {
  opacity: .6;
}

.take-icon {
  font-size: 30rpx;
  font-weight: 800;
}

.med-note {
  width: 100%;
  margin: -8rpx 0 16rpx;
  padding: 0 4rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: left;
}

.med-note-link {
  min-height: 96rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 650;
}

.med-note-arrow {
  margin-left: auto;
  font-size: 32rpx;
}

.med-list {
  padding: 8rpx 28rpx;
}

.med-row {
  min-height: 112rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.med-row:last-child {
  border-bottom: 0;
}

.med-main {
  flex: 1;
  min-width: 0;
}

.med-name {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.med-times {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.med-act {
  min-width: 96rpx;
  min-height: 96rpx;
  flex: none;
  padding: 0 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 650;
}

.med-act-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.med-add {
  margin-bottom: 24rpx;
}

.med-footer {
  padding-top: 8rpx;
  padding-bottom: 24rpx;
}

.med-sheet-body {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.med-label {
  color: var(--ink-2);
  font-size: 26rpx;
}

.med-name-in {
  height: 96rpx;
  font-size: 30rpx;
}

.med-time-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.med-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.med-time-picker {
  flex: 1;
  min-width: 0;
  display: block;
}

.med-time-cell {
  min-height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
}

.med-time-cell .time-label {
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 650;
}

.med-time-cell .time-value {
  margin-left: auto;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 650;
}

.med-time-cell .time-arrow {
  color: var(--ink-3);
  font-size: 30rpx;
}

.med-time-remove {
  min-width: 120rpx;
  min-height: 96rpx;
  flex: none;
  padding: 0 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 26rpx;
  font-weight: 650;
}

.med-time-remove[disabled] {
  opacity: .45;
}

.med-time-add {
  font-size: 28rpx;
}

.med-help {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 26rpx;
  line-height: 1.6;
}

.med-save {
  margin-top: 24rpx;
}
