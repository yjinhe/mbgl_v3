.msg {
  margin: 8rpx 0 20rpx;
}

.rec {
  position: relative;
  padding: 24rpx 22rpx 24rpx 34rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.rec .bar {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 8rpx;
  border-radius: 0 999rpx 999rpx 0;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 750;
}

.record-head .pill {
  min-height: 38rpx;
  padding: 6rpx 14rpx;
  font-size: 21rpx;
}

.tm {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.rec .val {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.rec .l2 {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-buttons {
  flex: 0 0 112rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.delete-mini,
.edit-mini {
  width: 112rpx;
  height: 80rpx;
  min-height: 80rpx;
  align-self: center;
  padding: 0;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1;
}

.edit-mini {
  color: var(--brand);
  background: var(--brand-soft);
}

.delete-mini text {
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}

.delete-mini-pressed {
  opacity: .72;
}

.load-error {
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.load-error button {
  margin-top: 20rpx;
}
