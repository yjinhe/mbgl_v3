<view class="app-stage">
  <view class="screen">
    <view class="safe-navbar" style="{{navStyle}}"><view class="title">历史记录</view></view>
    <view class="pages">
      <view class="page on">
          <view wx:if="{{!authed}}" class="demo-banner">
            <view class="demo-title">功能演示</view>
            <view class="demo-copy">这里展示演示记录。切换指标可浏览不同记录样式。</view>
          </view>
          <view class="msg">
            <button wx:for="{{metrics}}" wx:key="key" class="{{item.className}}" data-metric="{{item.key}}" bindtap="setMetric">{{item.name}}</button>
          </view>
          <view wx:if="{{!hasRecords}}" class="empty">暂无记录</view>
          <view wx:for="{{records}}" wx:key="id" class="rec">
            <view class="bar" style="background:{{item.statusColorValue}}"></view>
            <view class="mid">
              <view class="l1">{{item.periodText}}<text class="tm num">{{item.dateText}} {{item.timeText}}</text><text class="pill {{item.statusClass}}">{{item.status.label}}</text></view>
              <view class="l2">{{item.noteText}}</view>
            </view>
            <view class="val num" style="{{item.statusStyle}}">{{item.readText}}</view>
            <button wx:if="{{authed}}" class="delete-mini" data-id="{{item.id}}" catchtap="remove">删</button>
          </view>
          <button wx:if="{{authed && nextCursor}}" class="btn line" loading="{{loading}}" bindtap="loadMore">加载更多</button>
          <view class="foot-note">{{authed ? '删除后 7 天内可在回收站找回' : '演示记录不会上传或保存'}}</view>
      </view>
    </view>
    <view class="tabbar">
      <button class="tab" data-tab="home" bindtap="switchPage"><text class="ti">⌂</text><text>首页</text></button>
      <button class="tab on" data-tab="history" bindtap="switchPage"><text class="ti">☰</text><text>历史</text></button>
      <view class="fab-slot"><button class="fab" data-tab="record" bindtap="switchPage"><view class="drop"></view></button><text class="fab-label">记一笔</text></view>
      <button class="tab" data-tab="stats" bindtap="switchPage"><text class="ti">↗</text><text>统计</text></button>
      <button class="tab" data-tab="mine" bindtap="switchPage"><text class="ti">◯</text><text>我的</text></button>
    </view>
  </view>
</view>
