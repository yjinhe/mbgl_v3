<view class="app-stage">
  <view class="screen">
    <view class="safe-navbar" style="{{navStyle}}">
      <button class="back" bindtap="back">‹</button>
      <view class="title">绑定服务药房</view>
    </view>
    <view class="pages">
      <view class="page bind-page">
        <block wx:if="{{!authed}}">
          <view class="empty">
            <view>登录后绑定服务药房</view>
            <button class="btn primary login-btn" bindtap="login">微信一键登录</button>
          </view>
        </block>

        <block wx:else>
          <view class="card bind-card">
            <view class="title">绑定服务药房</view>
            <view class="desc">输入药房工作人员提供的邀请码，查询后确认授权。</view>
            <view class="code-row">
              <input maxlength="12" value="{{code}}" bindinput="onCodeInput" placeholder="如 KN23DEMO" />
              <button class="btn ghost" loading="{{loading}}" bindtap="query">查询</button>
            </view>
          </view>

          <view wx:if="{{preview}}" class="card preview">
            <view class="pharmacy-name">{{preview.pharmacyName}}</view>
            <view class="pharmacy-desc">{{preview.address}}</view>
            <view class="pharmacy-desc">邀请店员：{{preview.staffName}}</view>
            <button class="btn primary" bindtap="bindPharmacy">同意授权并绑定</button>
          </view>

          <view class="toast-note">绑定前会再次确认授权范围。解绑后药房立即无法查看你的记录。</view>
        </block>
      </view>
    </view>
  </view>
</view>
