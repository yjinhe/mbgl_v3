.login-btn {
  margin-top: 24rpx;
}

.bind-card {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 850;
}

.desc {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.code-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 14rpx;
}

.code-row input {
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  font-weight: 800;
  letter-spacing: .08em;
}

.preview {
  margin-top: 18rpx;
  padding: 30rpx;
}

.pharmacy-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 850;
}

.pharmacy-desc {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.preview .btn {
  margin-top: 28rpx;
}
