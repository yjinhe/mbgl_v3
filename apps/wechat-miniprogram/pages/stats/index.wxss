.msg {
  margin: 8rpx 0 20rpx;
}

.range-row {
  overflow: visible;
  padding-bottom: 14rpx;
}

.range-row .chip {
  width: 0;
  flex: 1 1 0;
}

.trend-card {
  margin-top: 4rpx;
}

.metric .k,
.metric .unit {
  font-size: 24rpx;
}

.bars {
  height: 260rpx;
  padding: 24rpx 8rpx 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
}

.bar-wrap {
  flex: 1;
  max-width: 44rpx;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 100%;
  min-height: 18rpx;
  border-radius: 999rpx 999rpx 10rpx 10rpx;
  background: linear-gradient(180deg, #19A77E, #0E7E6B);
  opacity: .82;
}
