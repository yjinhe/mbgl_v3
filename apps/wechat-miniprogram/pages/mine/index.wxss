.avatar-shell {
  position: relative;
  overflow: hidden;
}

.avatar-shell image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-trigger {
  position: absolute;
  inset: 0;
  width: 108rpx;
  height: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  min-height: 108rpx;
  max-height: 108rpx;
  padding: 0;
  border-radius: 50%;
  opacity: 0;
}

.cell-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.cell {
  min-height: 104rpx;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.cell:last-child {
  border-bottom: 0;
}

.cell .cm {
  flex: 1;
}

.cell .ct {
  font-size: 28rpx;
  font-weight: 550;
}

.cell .ct.brand {
  color: var(--brand);
}

.cell .cs {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.cell .cv {
  color: var(--ink-3);
  font-size: 32rpx;
}

.mini-seg {
  width: 148rpx;
  flex: none;
}

.unit-seg {
  width: 220rpx;
  flex: none;
}

.mini-seg button,
.unit-seg button {
  min-height: 52rpx;
  font-size: 22rpx;
}

.bound-cell {
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--brand-soft);
}

.bound-cell .bi {
  flex: 1;
}

.bound-cell .bn {
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 750;
}

.bound-cell .bs {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.danger-text {
  color: var(--danger);
  font-weight: 750;
}

.account-delete.disabled {
  opacity: .55;
}

.guest-login {
  margin-top: 20rpx;
}
