<view class="app-stage">
  <view class="screen">
    <view class="safe-navbar" style="{{navStyle}}"><view class="title">我的</view></view>
    <view class="pages">
      <view class="page on">
        <block wx:if="{{!authed}}">
          <view class="demo-banner">
            <view class="demo-title">游客体验</view>
            <view class="demo-copy">首页、历史、统计和记一笔均可免登录体验。登录仅用于保存和管理自己的记录。</view>
          </view>
          <view class="me-head"><view class="avatar">糖</view><view><view class="n">糖迹</view><view class="d">个人健康数据记录工具</view></view></view>
          <view class="sec-label">了解与选择</view>
          <view class="card cell-card">
            <view class="cell" bindtap="goTerms"><view class="cm"><view class="ct">用户协议</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="goPrivacy"><view class="cm"><view class="ct">隐私政策</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="openWechatPrivacy"><view class="cm"><view class="ct">微信隐私保护指引</view></view><view class="cv">›</view></view>
          </view>
          <view class="consent-row" bindtap="toggleConsent">
            <view class="consent-check {{consentChecked ? 'on' : ''}}">{{consentChecked ? '✓' : ''}}</view>
            <view class="consent-copy">我已阅读并同意<text class="legal-link" catchtap="goTerms">《用户协议》</text>和<text class="legal-link" catchtap="goPrivacy">《隐私政策》</text>，并同意处理我主动填写的健康数据</view>
          </view>
          <button class="btn primary guest-login" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信登录并保存记录</button>
          <view class="foot-note">登录为自愿选择，不获取手机号；头像和称呼都可以跳过</view>
        </block>
        <block wx:else>
          <view class="me-head">
            <view class="avatar avatar-shell">
              <image wx:if="{{me.avatarUrl}}" src="{{me.avatarUrl}}" mode="aspectFill" />
              <text wx:else>糖</text>
              <button class="avatar-trigger" open-type="chooseAvatar" disabled="{{updatingAvatar}}" bindchooseavatar="onChooseAvatar"></button>
            </view>
            <view><view class="n">{{me.nickname}}</view><view class="d">{{updatingAvatar ? '正在更新头像…' : '点击头像可以更换'}} · 已记录 {{me.stats.totalRecords}} 条</view></view>
          </view>

          <view class="sec-label">健康档案</view>
          <view class="card cell-card">
            <view class="cell">
              <view class="cm"><view class="ct">性别</view><view class="cs">影响尿酸参考上限</view></view>
              <view class="seg mini-seg"><button class="{{sexMaleClass}}" data-key="sex" data-value="male" bindtap="patch">男</button><button class="{{sexFemaleClass}}" data-key="sex" data-value="female" bindtap="patch">女</button></view>
            </view>
            <view class="cell">
              <view class="cm"><view class="ct">血糖单位</view><view class="cs">仅血糖支持单位切换</view></view>
              <view class="seg unit-seg"><button class="{{unitMmolClass}}" data-key="unit" data-value="mmol" bindtap="patch">mmol</button><button class="{{unitMgdlClass}}" data-key="unit" data-value="mgdl" bindtap="patch">mg/dL</button></view>
            </view>
          </view>

          <view class="sec-label">数据与隐私</view>
          <view class="card cell-card">
            <view class="cell" bindtap="goWeeklyReport"><view class="cm"><view class="ct">给家人看近7天记录</view><view class="cs">生成大字图片，自行选择转发或保存</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="exportAll"><view class="cm"><view class="ct">{{exporting ? '正在导出…' : '导出全部记录'}}</view><view class="cs">生成 ZIP 文件并通过微信发送或保存</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="goRecycle"><view class="cm"><view class="ct">回收站</view><view class="cs">删除的记录保留 7 天</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="goTerms"><view class="cm"><view class="ct">用户协议</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="goPrivacy"><view class="cm"><view class="ct">隐私政策</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="openWechatPrivacy"><view class="cm"><view class="ct">微信隐私保护指引</view></view><view class="cv">›</view></view>
            <view class="cell" bindtap="logout"><view class="cm"><view class="ct">退出登录</view><view class="cs">仅清除本机登录状态</view></view></view>
            <view class="cell account-delete {{deletingAccount ? 'disabled' : ''}}" bindtap="deleteAccount"><view class="cm"><view class="ct danger-text">{{deletingAccount ? '正在注销…' : '注销账号'}}</view><view class="cs">永久删除账号及全部关联数据</view></view></view>
          </view>
          <view class="foot-note">糖迹仅用于个人健康数据记录，不提供诊断、治疗或个性化建议</view>
        </block>
      </view>
    </view>
  </view>
</view>
