.legal-page {
  padding-bottom: 80rpx;
}

.legal-meta {
  margin: 12rpx 0 28rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.legal-title {
  margin-bottom: 32rpx;
  font-size: 40rpx;
  font-weight: 750;
}

.legal-heading {
  margin: 34rpx 0 12rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.legal-paragraph {
  margin-bottom: 16rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.85;
}

.privacy-contract {
  width: 100%;
  min-height: 88rpx;
  margin-top: 42rpx;
  border: 2rpx solid var(--brand);
  border-radius: 16rpx;
  color: var(--brand);
  font-weight: 650;
}
