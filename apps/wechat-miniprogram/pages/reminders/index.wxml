<view class="app-stage">
  <view class="screen">
    <view class="safe-navbar" style="{{navStyle}}">
      <button class="back" aria-label="返回" bindtap="back">‹</button>
      <view class="title">测量提醒</view>
    </view>
    <view class="pages">
      <view class="page reminders-page">
        <block wx:if="{{!authed}}">
          <view class="empty">
            <view>登录后设置测量提醒</view>
            <button class="btn primary login-btn" bindtap="login">微信一键登录</button>
          </view>
        </block>

        <block wx:elif="{{!available}}">
          <view class="empty">提醒功能暂未开放，请稍后再来</view>
        </block>

        <block wx:else>
          <view wx:for="{{cards}}" wx:key="metric" class="card reminder-card">
            <view class="reminder-head">
              <view class="reminder-head-main">
                <view class="reminder-name">{{item.name}}提醒</view>
                <view class="reminder-state">{{item.statusText}}</view>
              </view>
              <button class="switch reminder-switch {{item.switchClass}}" disabled="{{busyMetric === item.metric}}" aria-label="{{item.name}}提醒{{item.enabled ? '已开启' : '未开启'}}" data-metric="{{item.metric}}" bindtap="toggleReminder"><text>{{item.enabled ? '开' : '关'}}</text><view class="switch-knob"></view></button>
            </view>
            <picker class="reminder-picker" mode="time" value="{{item.time}}" disabled="{{busyMetric === item.metric}}" aria-label="{{item.name}}提醒时间 {{item.time}}" data-metric="{{item.metric}}" bindchange="onTimeChange">
              <view class="reminder-row"><text class="reminder-label">提醒时间</text><text class="reminder-value num">{{item.time}}</text><text class="reminder-arrow">›</text></view>
            </picker>
            <picker wx:if="{{item.isGlucose}}" class="reminder-picker" mode="selector" range="{{periodLabels}}" value="{{item.periodIndex}}" disabled="{{busyMetric === item.metric}}" aria-label="血糖测量时段 {{item.periodText}}" data-metric="{{item.metric}}" bindchange="onPeriodChange">
              <view class="reminder-row"><text class="reminder-label">测量时段</text><text class="reminder-value">{{item.periodText}}</text><text class="reminder-arrow">›</text></view>
            </picker>
          </view>
          <view class="reminder-note">每次保存记录时微信会请您确认一次提醒，勾选「总是保持以上选择」以后就不再询问。</view>
          <view class="reminder-note">到点时如果当天已经记录过，就不会再提醒。</view>
        </block>
      </view>
    </view>
  </view>
</view>
