.reminders-page {
  padding-bottom: 48rpx;
}

.login-btn {
  margin-top: 24rpx;
}

.reminder-card {
  padding: 24rpx 28rpx 8rpx;
}

.reminder-head {
  /* The whole title row is the tap target (≥ 96rpx), so the switch itself can stay a normal size. */
  min-height: 104rpx;
  margin: 0 -12rpx;
  padding: 0 12rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.reminder-head-hover {
  background: var(--paper);
}

.reminder-head.busy {
  opacity: .72;
}

.reminder-head-main {
  flex: 1;
  min-width: 0;
}

.reminder-name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.4;
}

.reminder-state {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.5;
}

/* Slightly larger than the global .switch (118×54) for older eyes, but no longer a giant pill:
   state is also spelled out in .reminder-state, so no text lives inside the track. */
.reminder-switch {
  width: 112rpx;
  height: 64rpx;
  flex: none;
  padding: 0;
  border-radius: 999rpx;
  background: #DCE5E1;
  transition: background .18s ease;
}

.reminder-switch .switch-knob {
  top: 6rpx;
  left: 6rpx;
  width: 52rpx;
  height: 52rpx;
  box-shadow: 0 3rpx 10rpx rgba(22, 48, 43, .16);
  transition: left .18s ease;
}

.reminder-switch.on {
  background: var(--ok);
}

.reminder-switch.on .switch-knob {
  left: 54rpx;
}

.reminder-picker {
  display: block;
}

.reminder-row {
  min-height: 104rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reminder-picker:last-child .reminder-row {
  border-bottom: 0;
}

.reminder-sub {
  min-height: 88rpx;
  border-bottom: 0;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.5;
}

.reminder-label {
  flex: 1;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 600;
}

.reminder-value {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 650;
}

.reminder-arrow {
  color: var(--ink-3);
  font-size: 32rpx;
}

.reminder-note {
  margin: 0 4rpx 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}
