generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  openid        String             @unique
  miniOpenid    String?            @unique
  webOpenid     String?            @unique
  unionid       String?            @unique
  loginName     String?            @unique
  passwordHash  String?
  authVersion   Int                @default(0)
  nickname      String             @default("微信用户")
  adminNote     String             @default("")
  avatarUrl     String?
  sex           String?
  unit          String             @default("mmol")
  fastingLow    Decimal            @default(4.4)
  fastingHigh   Decimal            @default(7.0)
  postMealHigh  Decimal            @default(10.0)
  deactivatedAt DateTime?
  createdAt     DateTime           @default(now())
  glucose       GlucoseRecord[]
  bp            BpRecord[]
  lipid         LipidRecord[]
  uric          UricRecord[]
  summaries     DailySummary[]
  binding       PharmacyCustomer[]
  submissions   RecordSubmission[]
  reminders     ReminderPlan[]
  medications   Medication[]
}

model RecordSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  metric      String
  requestHash String
  recordId    String?
  createdAt   DateTime @default(now())

  @@unique([userId, key])
}

model ReminderPlan {
  id          String   @id @default(cuid())
  userId      String
  metric      String // 'glucose' | 'bp' | 'medication'
  enabled     Boolean  @default(false)
  time        String // 'HH:mm', Asia/Shanghai; fixed '00:00' and unused for medication
  period      String? // glucose period, null for bp and medication
  quota       Int      @default(0) // remaining one-time subscription sends
  lastSentDay String? // 'YYYY-MM-DD', Asia/Shanghai, prevents same-day resend (unused for medication, see ReminderLog.slot)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric])
}

model ReminderLog {
  id           String   @id @default(cuid())
  userId       String
  metric       String
  templateKey  String // 'glucose_reminder' | 'bp_reminder' | 'medication_reminder'
  scheduledDay String // 'YYYY-MM-DD'
  slot         String? // 'HH:mm', medication reminders only: one row per (user, day, slot) whatever the outcome
  sentAt       DateTime @default(now())
  ok           Boolean
  errcode      Int?
  errmsg       String?

  @@index([userId, scheduledDay])
}

model Medication {
  id         String    @id @default(cuid())
  userId     String
  name       String // ≤ 20 chars, typed by the user
  times      String // JSON array of 'HH:mm', 1-4 entries, deduplicated and ascending
  archivedAt DateTime? // deleting archives, so check-in history stays available for reports
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       MedicationLog[]

  @@index([userId, archivedAt])
}

model MedicationLog {
  id           String     @id @default(cuid())
  userId       String
  medicationId String
  day          String // 'YYYY-MM-DD', Asia/Shanghai
  slot         String // 'HH:mm'
  takenAt      DateTime   @default(now())
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, day, slot])
  @@index([userId, day])
}

model GlucoseRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  valueMmol  Decimal
  period     String
  measuredAt DateTime
  tags       String    @default("[]")
  note       String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, measuredAt])
  @@index([userId, deletedAt])
}

model BpRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  sbp        Int
  dbp        Int
  pulse      Int?
  period     String
  measuredAt DateTime
  tags       String    @default("[]")
  note       String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, measuredAt])
}

model LipidRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tc         Decimal?
  tg         Decimal?
  ldl        Decimal?
  hdl        Decimal?
  fasting    Boolean   @default(true)
  measuredAt DateTime
  note       String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, measuredAt])
}

model UricRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  value      Int
  fasting    Boolean   @default(true)
  measuredAt DateTime
  note       String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, measuredAt])
}

model DailySummary {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  date    String
  avg     Decimal
  max     Decimal
  min     Decimal
  count   Int
  okCount Int

  @@unique([userId, date])
}

model Pharmacy {
  id         String             @id @default(cuid())
  name       String
  address    String             @default("")
  phone      String             @default("")
  disabledAt DateTime?
  createdAt  DateTime           @default(now())
  staff      PharmacyStaff[]
  customers  PharmacyCustomer[]
  invites    InviteCode[]
}

model PharmacyStaff {
  id           String    @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy  @relation(fields: [pharmacyId], references: [id])
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("staff")
  authVersion  Int       @default(0)
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
}

model InviteCode {
  id         String             @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy           @relation(fields: [pharmacyId], references: [id])
  staffId    String
  code       String             @unique
  expiresAt  DateTime
  disabledAt DateTime?
  createdAt  DateTime           @default(now())
  bindings   PharmacyCustomer[]
}

model PharmacyCustomer {
  id           String      @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy    @relation(fields: [pharmacyId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  inviteCodeId String?
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])
  consentAt    DateTime    @default(now())
  unboundAt    DateTime?
  // SQLite partial unique index for active bindings is maintained by migrations.

  @@index([pharmacyId, unboundAt])
  @@index([userId, unboundAt])
}

model FollowUp {
  id         String   @id @default(cuid())
  pharmacyId String
  staffId    String
  metric     String
  recordId   String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([pharmacyId, metric, recordId])
}

model PharmacyAccessLog {
  id         String   @id @default(cuid())
  pharmacyId String
  staffId    String
  userId     String
  action     String
  createdAt  DateTime @default(now())

  @@index([pharmacyId, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  authVersion  Int      @default(0)
  createdAt    DateTime @default(now())
}
